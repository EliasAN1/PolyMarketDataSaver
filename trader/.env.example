# Same shape as a typical py-clob-client bot.
# POLYMARKET_PRIVATE_KEY=  (hex, 0x optional)
# POLYMARKET_FUNDER=       (deposit / proxy address that holds pUSD)
# POLYMARKET_SIGNATURE_TYPE=3

POLYMARKET_PRIVATE_KEY=
POLYMARKET_FUNDER=
POLYMARKET_WALLET_ADDRESS=
POLYMARKET_SIGNATURE_TYPE=3
POLYMARKET_CHAIN_ID=137

# Optional L2 HMAC. Leave blank — the client derives these from the private key.
# Only fill them in if derive fails (some deposit wallets).
# Optional. Leave blank so the UI stays on this PC only.
# Phone access is via Tailscale Serve (see README), not by opening this port on the LAN.
# UI_HOST=127.0.0.1
# UI_PORT=3848

